# ─────────────────────────────────────────────────────────────
# বিশ্বাস এগ্রো / Biswas Agro — environment variables
# Copy to .env.local for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API Keys) ──────────────────
NEXT_PUBLIC_SUPABASE_URL=https://izemauiuyqcdawijoloh.supabase.co

# Publishable key (sb_publishable_…). PUBLIC by design: it ships to every
# visitor and is only a rate-limit identity; RLS is the real boundary.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Legacy name, accepted as a fallback so an existing deployment keeps working:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secret key (sb_secret_…). SERVER ONLY — never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=your-secret-key
# Legacy fallback: SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hard deadline for every server-side query (ms). A stalled request falls back
# to seeded/section-less content instead of hanging the render. Default 8000.
SUPABASE_TIMEOUT_MS=8000

# There is no JWT_SECRET any more: sessions are Supabase cookies managed by
# @supabase/ssr. If the variable still exists in Vercel, nothing reads it.

# ── Public site URL ─────────────────────────────────────────
# THE ONLY PLACE THE DEPLOYMENT ADDRESS IS SPELLED.
# Metadata, sitemap.xml, robots.txt, canonical tags, Open Graph and JSON-LD all
# read this (lib/site-url.ts). Leave it unset and Vercel's own hostname is used.
#
#   First deploy, no domain:   https://<project-name>.vercel.app
#   Later, with a domain:      https://bishwasagro.com
#
# No trailing slash. Changing it needs a redeploy (it is inlined at build time).
NEXT_PUBLIC_SITE_URL=https://biswas-agro.vercel.app

# Vercel sets VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL / VERCEL_ENV
# automatically — do NOT add them by hand. lib/site-url.ts uses them as the
# fallback and next.config.ts turns VERCEL_ENV=preview into a noindex header.

# ── Analytics / search verification (section D) ─────────────
# GA4. Leave empty to keep analytics dark (no script is injected).
NEXT_PUBLIC_GA_ID=
# Google Search Console → "HTML tag" verification value (content="...").
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (optional).
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_WHATSAPP=8801700000000
NEXT_PUBLIC_PHONE=+8801700000000

# ── SMS / OTP ───────────────────────────────────────────────
# When unset, OTP codes are returned in the API response in
# non-production ("dev mode") so you can test phone login.
SMS_PROVIDER=                       # sslwireless | bulksmsbd | none
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=

# ── Payments ────────────────────────────────────────────────
# bKash (sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://biswas-agro.vercel.app/api/payments/bkash/callback

# SSLCommerz (sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox-ssl.mynagad.com

# Set to false in production once live gateways are configured
PAYMENTS_SANDBOX=true

# ── Ops ─────────────────────────────────────────────────────
# The panel path. One env var, no code change. Must match the folder name in
# app/ (default "foisal"). Lowercase letters, digits and hyphens only.
ADMIN_PATH=foisal
# Public mirror of the same value: NEXT_PUBLIC_* is the only kind of variable
# inlined into the browser bundle, and the sidebar links need it client-side.
NEXT_PUBLIC_ADMIN_PATH=foisal

# ── Supabase Auth (Google + email verification) ─────────────
# Auth is plain Supabase: lib/supabase/{client,server,middleware}.ts.
# The publishable key is public by design and used by the browser client for
# Google login. The secret key must never be prefixed with NEXT_PUBLIC_.
# Supabase → Authentication → URL Configuration:
#   Site URL            https://bishwasagro.vercel.app
#   Redirect URLs       https://bishwasagro.vercel.app/**
#                       http://localhost:3000/**

# ── Admin account ───────────────────────────────────────────
# There is NO bootstrap endpoint. Create the admin once in Supabase:
#   1. Authentication → Users → Add user  (email + password, "Auto Confirm")
#   2. run supabase/admin.sql in the SQL editor
# See README §26. ADMIN_EMAIL / ADMIN_PASSWORD / SEED_SECRET are NOT used by
# this app and must not be added to Vercel.

# ── Live farm streaming (premium CCTV) ──────────────────────
# Where MediaMTX (HLS) / go2rtc (WebRTC) live. Leave empty to keep the
# feature dark: the UI then shows "স্ট্রিমিং সার্ভার কনফিগার করা হয়নি".
STREAM_PROXY_TARGET=
GO2RTC_WHEP_URL=
# Shared secret between the Next proxy and the stream edge (Caddyfile).
STREAM_PROXY_SECRET=
# Optional: a dedicated signing key for 5-minute stream tokens.
# When unset, a stable key is derived from the Supabase server credentials.
STREAM_TOKEN_SECRET=

# ── Push notifications ──────────────────────────────────────
# Generate a VAPID pair (no external service needed):
#   node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log(publicKey.export({type:'spki',format:'der'}).toString('base64url'));console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64url'))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bishwasagro.com

# Firebase Cloud Messaging (Android app push)
FCM_SERVER_KEY=

# ── Email ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Biswas Agro <hello@bishwasagro.com>

# ── Parcel QR ───────────────────────────────────────────────
# Salt for the unguessable parcel QR token. When unset, derived from the
# Supabase server credentials.
ORDER_QR_SECRET=

# ── Android shell (Capacitor) ───────────────────────────────
# No domain yet? Point the app at the vercel.app URL — it is HTTPS, so Android
# accepts it without any cleartext flag.
#   CAPACITOR_SERVER_URL=https://biswas-agro.vercel.app
# Later, after adding a domain, switch to https://bishwasagro.com.
# For the Android emulator against a local dev server:
#   CAPACITOR_SERVER_URL=http://10.0.2.2:3000
# Google login returns through https://<deployment>/auth/callback and then fires
# biswasagro://auth-callback (see app/auth/native/page.tsx).
