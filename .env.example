# ─────────────────────────────────────────────────────────────
# বিশ্বাস এগ্রো / Biswas Agro — environment variables
# Copy to .env.local for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://lyihdzgmtjkkhybpkqot.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEVER expose this to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing secret (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site
NEXT_PUBLIC_SITE_URL=https://bishwasagro.com
NEXT_PUBLIC_WHATSAPP=8801700000000
NEXT_PUBLIC_PHONE=+8801700000000

# ── SMS / OTP ───────────────────────────────────────────────
# When unset, OTP codes are returned in the API response in
# non-production ("dev mode") so you can test phone login.
SMS_PROVIDER=                       # sslwireless | bulksmsbd | none
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=

# ── Payments ────────────────────────────────────────────────
# bKash (sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://bishwasagro.com/api/payments/bkash/callback

# SSLCommerz (sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox-ssl.mynagad.com

# Set to false in production once live gateways are configured
PAYMENTS_SANDBOX=true

# ── Ops ─────────────────────────────────────────────────────
# Bootstrap admin account used by `npm run db:admin`
ADMIN_EMAIL=admin@bishwasagro.com
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=Admin@12345

# ── Supabase Auth (Google + email verification) ─────────────
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the SAME key already set above — it is
# public by design and used by the browser client for Google login.
# SUPABASE_SERVICE_ROLE_KEY must never be prefixed with NEXT_PUBLIC_.

# ── One-time admin bootstrap ────────────────────────────────
# Set these, POST /api/setup/seed-admin once with the SEED_SECRET,
# then DELETE SEED_SECRET (and ADMIN_PASSWORD) from Vercel.
SEED_SECRET=

# ── Live farm streaming (premium CCTV) ──────────────────────
# Where MediaMTX (HLS) / go2rtc (WebRTC) live. Leave empty to keep the
# feature dark: the UI then shows "স্ট্রিমিং সার্ভার কনফিগার করা হয়নি".
STREAM_PROXY_TARGET=
GO2RTC_WHEP_URL=
# Shared secret between the Next proxy and the stream edge (Caddyfile).
STREAM_PROXY_SECRET=
# Optional: a dedicated signing key for 5-minute stream tokens.
# Falls back to JWT_SECRET when unset.
STREAM_TOKEN_SECRET=

# ── Push notifications ──────────────────────────────────────
# Generate a VAPID pair (no external service needed):
#   node -e "const c=require('crypto');const {publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});console.log(publicKey.export({type:'spki',format:'der'}).toString('base64url'));console.log(privateKey.export({type:'pkcs8',format:'der'}).toString('base64url'))"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@bishwasagro.com

# Firebase Cloud Messaging (Android app push)
FCM_SERVER_KEY=

# ── Email ───────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=Biswas Agro <hello@bishwasagro.com>

# ── Parcel QR ───────────────────────────────────────────────
# Salt for the unguessable parcel QR token. Falls back to JWT_SECRET.
ORDER_QR_SECRET=

# ── Android shell (Capacitor) ───────────────────────────────
# CAPACITOR_SERVER_URL=https://bishwasagro.com
# For the Android emulator against a local server:
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000
