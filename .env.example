# ─────────────────────────────────────────────────────────────
# বিশ্বাস এগ্রো / Biswas Agro — environment variables
# Copy to .env.local for development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://lyihdzgmtjkkhybpkqot.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEVER expose this to the browser. Server-only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Session signing secret (openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Public site
NEXT_PUBLIC_SITE_URL=https://bishwasagro.com
NEXT_PUBLIC_WHATSAPP=8801700000000
NEXT_PUBLIC_PHONE=+8801700000000

# ── SMS / OTP ───────────────────────────────────────────────
# When unset, OTP codes are returned in the API response in
# non-production ("dev mode") so you can test phone login.
SMS_PROVIDER=                       # sslwireless | bulksmsbd | none
SMS_API_KEY=
SMS_SENDER_ID=
SMS_API_URL=

# ── Payments ────────────────────────────────────────────────
# bKash (sandbox: https://tokenized.sandbox.bka.sh/v1.2.0-beta)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_CALLBACK_URL=https://bishwasagro.com/api/payments/bkash/callback

# SSLCommerz (sandbox)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://sandbox-ssl.mynagad.com

# Set to false in production once live gateways are configured
PAYMENTS_SANDBOX=true

# ── Ops ─────────────────────────────────────────────────────
# Bootstrap admin account used by `npm run db:admin`
ADMIN_EMAIL=admin@bishwasagro.com
ADMIN_PHONE=01700000000
ADMIN_PASSWORD=Admin@12345
