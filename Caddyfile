# ============================================================================
# Stream edge in DIRECT-VIDEO mode — the recommended setup
# ----------------------------------------------------------------------------
# The browser plays  https://<STREAM_PUBLIC_HOST>/live-<EDGE_SECRET>/hls/<key>/index.m3u8?t=<token>
# so video bytes go VPS → viewer and never touch Vercel's bandwidth meter.
#
# Three locks protect it, in this order:
#   1. the /live-<EDGE_SECRET>/ prefix — a random 16+ character string that
#      nobody can guess. Without it every path 404s.
#   2. ?t=<signed token> — 5 minutes, revocable, minted only for a subscriber
#      or a trial device.
#   3. forward_auth → the app's /api/stream/auth — the token is VERIFIED on
#      every playlist request: signature, expiry, the session row (so revoking
#      stops the picture early), and the stream key (so a token for camera A
#      cannot open camera B).
#
#   Before this, lock 2 was only "does the URL contain a ?t= at all" — Caddy
#   cannot check an HS256 JWT by itself, so any string worked and a 5-minute
#   token was really "5 minutes of access to whoever you send the link to,
#   with no signature check". Now the app decides.
#
# WHAT CADDY STILL DOES NOT VERIFY: segments and LL-HLS parts.
#   hls.js fetches those without a query string, often several per second.
#   Authorising each one would put a database round-trip in the hot path of
#   every viewer and would race the very first segment against the playlist.
#   Their names are only learnable from a playlist that passed forward_auth,
#   and MediaMTX deletes them ~60 s after the last authorised viewer leaves.
#   This is the standard HLS trade-off and it is why the playlist must always
#   be gated.
#
# Set these in .env next to this file:
#   STREAM_PUBLIC_HOST=stream.yourdomain.com
#   STREAM_EDGE_SECRET=16-plus-random-characters
#   APP_INTERNAL_URL=http://<vercel-app-or-tunnel>   (forward_auth target)
#   MEDIAMTX_READ_AUTH=Basic base64("reader:<MEDIAMTX_READ_PASS>")  (see below)
#
# MEDIAMTX_READ_AUTH is generated by docker-compose.stream-vps.yml from
# MEDIAMTX_READ_PASS — do not type it by hand.
# and the matching Vercel var:
#   STREAM_PUBLIC_BASE=https://stream.yourdomain.com/live-<EDGE_SECRET>
#   STREAM_PROXY_TARGET=https://stream.yourdomain.com/health-<EDGE_SECRET>
#
# EDGE_HTTPS_PORT defaults to 443. Only docker-compose.stream-vps.yml sets it,
# to 8443 when it runs on the host network (so a local dev/CI proxy on :443
# does not collide); leave it alone on a real VPS.
#
# TLS is Caddy's job here: point the A record at the VPS, open 80 + 443, run
#   docker compose -f docker-compose.stream-vps.yml --profile public up -d
# ============================================================================

{
	admin off
	email {$ACME_EMAIL:admin@example.com}
}

{$STREAM_PUBLIC_HOST:stream.example.com}:{$EDGE_HTTPS_PORT:443} {
	encode zstd gzip

	# /live-<secret>/hls/<key>/index.m3u8?t=<token>  →  MediaMTX /<key>/index.m3u8
	handle_path /live-{$STREAM_EDGE_SECRET}/hls/* {
		# Only PLAYLISTS need the token. Segments/parts carry no query string —
		# hls.js resolves them relatively, so demanding ?t= here would break
		# playback. Their names are only known from a token-gated playlist.
		@playlistNoToken {
			path *.m3u8
			not query t=*
		}
		respond @playlistNoToken "unauthorized" 401

		# Verify the token for real. Caddy cannot check an HS256 signature by
		# itself, so it asks the app. `{http.request.uri}` starts with "/",
		# so the forwarded value is "?path=/hls/<key>/index.m3u8".
		@playlist path *.m3u8
		forward_auth @playlist {$APP_INTERNAL_URL:http://127.0.0.1:3000} {
			uri /api/stream/auth?path={http.request.uri}
			copy_headers X-Stream-Key X-Stream-Camera
		}

		# Reading from MediaMTX now needs credentials too (mediamtx.yml, supplied
		# via MTX_AUTHINTERNALUSERS_1_*). The browser never sees them — Caddy
		# adds Basic auth on the internal hop. MediaMTX accepts Basic auth for
		# HLS, so no `?user=&pass=` (which would land in access logs).
		reverse_proxy mediamtx:8888 {
			header_up -X-Stream-Key
			header_up -X-Stream-Camera
			header_up Authorization "Basic {env.MEDIAMTX_READ_AUTH}"
		}
	}

	# Vercel → edge control routes (never video):
	#   GET  /health-<secret>/<key>/index.m3u8   admin "camera online?" probe
	#   POST /health-<secret>/api/webrtc?src=…   WebRTC signalling (go2rtc)
	# Set STREAM_PROXY_TARGET=https://<host>/health-<EDGE_SECRET> in Vercel.
	handle_path /health-{$STREAM_EDGE_SECRET}/* {
		@whep path /api/webrtc*
		handle @whep {
			reverse_proxy go2rtc:1984
		}
		handle {
			# The server-side probe is authorised by the secret prefix itself;
			# still requires the read credentials MediaMTX now insists on.
			reverse_proxy mediamtx:8888 {
				header_up -X-Stream-Key
				header_up -X-Stream-Camera
				header_up Authorization "Basic {env.MEDIAMTX_READ_AUTH}"
			}
		}
	}

	# nothing else exists on this hostname
	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}
