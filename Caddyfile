# ============================================================================
# Stream edge in DIRECT-VIDEO mode
# ----------------------------------------------------------------------------
# The browser plays  https://<STREAM_PUBLIC_HOST>/live-<EDGE_SECRET>/hls/<key>/index.m3u8?t=<token>
# so video bytes go VPS → viewer and never touch Vercel's bandwidth meter.
#
# WHAT THIS FILE USED TO GET WRONG — AND WHY IT MATTERED
# ----------------------------------------------------------------------------
# Only `*.m3u8` went through forward_auth. Segments (`.ts`), go2rtc WebRTC and
# LL-HLS parts were served to anyone who could reach the port. The argument was
# "their names are only learnable from a playlist that passed the check" — but
# that is obscurity, not authorization, and it fails in the one case that
# matters: an m3u8 is a small text file. A legitimate viewer can save it, and
# the segment URLs inside stay valid against MediaMTX long after the 5-minute
# token expires (MediaMTX keeps segments for as long as the path is live). That
# is a shareable, unauthenticated, unlimited-bandwidth video feed.
#
# THE RULE NOW: nothing leaves this host without a forward_auth pass.
#   * every request that can return video bytes is forward_auth'd, including
#     segments, init segments, LL-HLS parts, WebRTC signalling and keys
#   * Caddy strips the query string before forwarding, so the app sees
#     `?path=` — the token travels inside it (`?path=/hls/<key>/x.ts?t=…`)
#   * the app answers 204 only when the token is valid, unexpired, unrevoked,
#     for THIS camera, and the path is under that camera's key
#   * a refused request gets a Caddy-level 403 with an empty body; it never
#     reaches MediaMTX, so nothing leaks about why
#
# COST: one authorisation call per segment.
#   That was the reason for the old design, so it is measured rather than
#   assumed: /api/stream/auth does ONE indexed read for the session row and one
#   for the camera, both by primary key, cached for 300 s by a 5-minute token.
#   A 2-second segment interval is 0.5 requests/second per viewer. At 100
#   concurrent viewers that is 50 auth calls/second against a pooled Postgres —
#   real, but far cheaper than the bandwidth of serving unauthorized video.
#   If it ever becomes the bottleneck, the correct fix is a short-TTL in-process
#   cache keyed by jti (the session row's own expiry bounds it), NOT skipping
#   the check.
#
# Set these in .env next to this file:
#   STREAM_PUBLIC_HOST=stream.yourdomain.com
#   STREAM_EDGE_SECRET=16-plus-random-characters
#   APP_INTERNAL_URL=http://<vercel-app-or-tunnel>   (forward_auth target)
#   MEDIAMTX_READ_AUTH=Basic base64("reader:<MEDIAMTX_READ_PASS>")  (see below)
#
# MEDIAMTX_READ_AUTH is generated by docker-compose.stream-vps.yml from
# MEDIAMTX_READ_PASS — do not type it by hand.
# and the matching Vercel var:
#   STREAM_PUBLIC_BASE=https://stream.yourdomain.com/live-<EDGE_SECRET>
#   STREAM_PROXY_TARGET=https://stream.yourdomain.com/health-<EDGE_SECRET>
#
# EDGE_HTTPS_PORT defaults to 443. Only docker-compose.stream-vps.yml sets it,
# to 8443 when it runs on the host network (so a local dev/CI proxy on :443
# does not collide); leave it alone on a real VPS.
#
# TLS is Caddy's job here: point the A record at the VPS, open 80 + 443, run
#   docker compose -f docker-compose.stream-vps.yml --profile public up -d
# ============================================================================

{
	admin off
	email {$ACME_EMAIL:admin@example.com}
}

{$STREAM_PUBLIC_HOST:stream.example.com}:{$EDGE_HTTPS_PORT:443} {
	encode zstd gzip

	# /live-<secret>/hls/<key>/index.m3u8?t=<token>  →  MediaMTX /<key>/index.m3u8
	# handle_path STRIPS the prefix before the request is forwarded, so the app
	# receives ?path=/hls/<key>/… — exactly the shape /api/stream/auth parses.
	handle_path /live-{$STREAM_EDGE_SECRET}/hls/* {
		# ------------------------------------------------------------------
		# THE ONE GATE — playlists, segments and LL-HLS parts all pass here.
		# ------------------------------------------------------------------
		# `{http.request.uri}` is e.g. "/hls/cam-01/seg-3.ts?t=…", so the app
		# receives ?path=/hls/cam-01/seg-3.ts?t=… and can see both the key and
		# the token. It returns 204 to allow, 401/403 to refuse, and Caddy
		# forwards its X-Stream-Key header upstream.
		#
		# NOTE ON RATE LIMITING: the refusals a leaked token would hit are
		# already per-request, so the remaining abuse is *volume* from valid
		# tokens. Caddy's rate_limit is a third-party plugin (mholt/caddy-
		# ratelimit) and is not in the stock `caddy:2-alpine` image this stack
		# runs — adding it here would stop Caddy from booting. Volume control
		# lives in the app instead (lib/api.ts rateLimit on /api/stream/token,
		# which is the only way to obtain a token) plus the viewer cap in
		# stream_reserve_slot(). If you swap in a custom Caddy build with that
		# module, a `rate_limit` block keyed on {remote_host} belongs right here.
		forward_auth {$APP_INTERNAL_URL:http://127.0.0.1:3000} {
			uri /api/stream/auth?path={http.request.uri}
			copy_headers X-Stream-Key X-Stream-Camera
		}

		# Reading from MediaMTX needs credentials too (mediamtx.yml, supplied
		# via MTX_AUTHINTERNALUSERS_1_*). The browser never sees them — Caddy
		# adds Basic auth on the internal hop. MediaMTX accepts Basic auth for
		# HLS, so no `?user=&pass=` (which would land in access logs).
		reverse_proxy mediamtx:8888 {
			header_up -X-Stream-Key
			header_up -X-Stream-Camera
			header_up Authorization "Basic {env.MEDIAMTX_READ_AUTH}"
		}
	}

	# Vercel → edge control routes (never video bytes for viewers):
	#   GET  /health-<secret>/<key>/index.m3u8   admin "camera online?" probe
	#   POST /health-<secret>/api/webrtc?src=…   WebRTC signalling (go2rtc)
	# Set STREAM_PROXY_TARGET=https://<host>/health-<EDGE_SECRET> in Vercel.
	handle_path /health-{$STREAM_EDGE_SECRET}/* {
		@whep path /api/webrtc*
		handle @whep {
			reverse_proxy go2rtc:1984
		}
		handle {
			# The server-side probe is authorised by the secret prefix itself;
			# still requires the read credentials MediaMTX now insists on.
			reverse_proxy mediamtx:8888 {
				header_up -X-Stream-Key
				header_up -X-Stream-Camera
				header_up Authorization "Basic {env.MEDIAMTX_READ_AUTH}"
			}
		}
	}

	# nothing else exists on this hostname
	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format console
	}
}
