{
  "name": "biswas-agro",
  "version": "1.0.0",
  "private": true,
  "description": "বিশ্বাস এগ্রো (Biswas Agro) — Farm to Family. Organic food & fresh produce delivery in Bangladesh.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
    "analyze": "ANALYZE=true next build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "budget:report": "node scripts/check-bundle-budget.mjs --report",
    "lighthouse": "node scripts/lighthouse-audit.mjs",
    "security": "node scripts/security-scan.mjs",
    "verify": "npm run typecheck && npm run lint && npm run db:check && npm run db:chat && npm run db:columns && npm run db:permissions && npm run test:security && npm run test:orders && npm run test:payments && npm run test:tracking && npm run test:stream && npm run test:slots && npm run test:sellersync && npm run db:stream && npm run security && npm run budget",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:check": "node scripts/check-sql.mjs",
    "db:chat": "node scripts/test-live-chat.mjs",
    "db:columns": "node scripts/check-columns.mjs",
    "test:security": "node scripts/test-security-hardening.mjs",
    "db:permissions": "node scripts/check-permissions.mjs",
    "test:orders": "node scripts/test-order-money.mjs",
    "db:stream": "node scripts/check-stream-edge.mjs",
    "test:stream": "node scripts/test-stream-auth.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:slots": "node scripts/test-stream-slots.mjs",
    "test:tracking": "node scripts/test-tracking-privacy.mjs",
    "test:cctv": "node scripts/test-stream-edge-live.mjs",
    "test:sellersync": "node scripts/test-seller-farm-sync.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "hls.js": "^1.7.4",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^6.19.0",
    "next": "^15.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
