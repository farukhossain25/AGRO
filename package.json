{
  "name": "biswas-agro",
  "version": "1.0.0",
  "private": true,
  "description": "বিশ্বাস এগ্রো (Biswas Agro) — Farm to Family. Organic food & fresh produce delivery in Bangladesh.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:seed:sql": "node scripts/seed-sql.mjs > supabase/seed.sql",
    "db:admin": "node --env-file=.env.local scripts/create-admin.mjs",
    "db:seed:premium": "node --experimental-strip-types scripts/seed-premium-sql.mjs > supabase/seed-premium.sql",
    "cap:sync": "npx cap sync android",
    "analyze": "ANALYZE=true next build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "budget:report": "node scripts/check-bundle-budget.mjs --report",
    "lighthouse": "node scripts/lighthouse-audit.mjs"
  },
  "dependencies": {
    "@fontsource/hind-siliguri": "^5.3.0",
    "@fontsource/noto-sans-bengali": "^5.3.0",
    "@supabase/supabase-js": "^2.45.4",
    "bcryptjs": "^2.4.3",
    "hls.js": "^1.7.4",
    "jose": "^5.9.6",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "maplibre-gl": "^6.19.0",
    "next": "15.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
